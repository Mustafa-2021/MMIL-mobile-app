rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
//
// Phase 0 baseline: matches how the app works today (any signed-in user can read and
// write the app's collections; admin vs. member is enforced in the UI). Phase 1 replaces
// this with role-based rules once the employee login and per-section roles exist.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /teams/{teamId} {
      allow read, write: if signedIn();
    }

    match /users/{uid} {
      allow read, write: if signedIn();
    }

    match /tasks/{taskId} {
      allow read, write: if signedIn();

      match /comments/{commentId} {
        allow read, write: if signedIn();
      }
    }

    match /notifications/{notificationId} {
      allow read, write: if signedIn();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
